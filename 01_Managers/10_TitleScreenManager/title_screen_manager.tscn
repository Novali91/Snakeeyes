[node name="TextBox" parent="." unique_id=215385471 instance=ExtResource("5_37l6j")]
text_array = Array[String](["Unlesss my eyesss deceive me, you've been poisoned...", "Death's embrace is cold, isss it not?", "Come inssside my shop, I will help you...", "I'm glad you sssee reason. Your will to live outweighsss your fear.", "...", "Welcome dear, don't be alarmed by my many ssssnakesss...", "Nobody trusts sssnake oil merchants anymore...", " 'Real' medicine blindsss people from the truth.", "Practitionersss of health sssimply must reside near death.", "You must know, my sssnake venom can even make you grow ssstronger.", "...", "Oh, you want a cure for the poison that ailsss you?", "But you only jussst got here-", "It'd be rude to leave ssso sssoon...", "Let'sss play a game... If you win I'll give you the cure.", "If you lose, well that issss for you to find out..."])
